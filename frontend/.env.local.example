# Points the frontend at the backend API.
#
# Local development: copy this file to `.env.local` and use the local backend:
#   NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
#
# Production (Vercel): set this in the Vercel project's Environment Variables to
# your deployed Railway backend URL (no trailing slash). NEXT_PUBLIC_* vars are
# baked in at build time, so redeploy the frontend after changing it.
NEXT_PUBLIC_BACKEND_URL=https://vercel-next-production.up.railway.app
